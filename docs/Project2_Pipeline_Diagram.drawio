<diagram id="p2pipeline" name="Training to Inference">
<mxGraphModel dx="1460" dy="1911" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1911" math="0" shadow="0"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p1001" value="&lt;b&gt;How the Smart Dressing Learns, and How It Decides&lt;/b&gt;" style="text;html=1;fontSize=29;align=center;fontColor=#16202A;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="1460" height="36" as="geometry"/></mxCell>
<mxCell id="p1002" value="&lt;i&gt;each block says what that stage does; the labels on the arrows say what is handed to the next stage&lt;/i&gt;" style="text;html=1;fontSize=12;align=center;fontColor=#65717B;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="0" y="78" width="1460" height="20" as="geometry"/></mxCell>
<mxCell id="p1003" value="" style="rounded=1;arcSize=6;html=1;fillColor=#F5F7F8;strokeColor=#E3E8EB;container=0;" vertex="1" parent="1"><mxGeometry x="126" y="112" width="1300" height="371" as="geometry"/></mxCell>
<mxCell id="p1004" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;html=1;fillColor=#16202A;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="65" y="131" width="30" height="30" as="geometry"/></mxCell>
<mxCell id="p1005" value="&lt;b&gt;LEARNING FROM DATA&lt;/b&gt;" style="text;html=1;horizontal=0;align=center;fontSize=11;fontColor=#65717B;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="22" y="112" width="40" height="371" as="geometry"/></mxCell>
<mxCell id="p1006" value="" style="rounded=1;arcSize=6;html=1;fillColor=#F5F7F8;strokeColor=#E3E8EB;container=0;" vertex="1" parent="1"><mxGeometry x="126" y="517" width="1300" height="131" as="geometry"/></mxCell>
<mxCell id="p1007" value="&lt;b&gt;2&lt;/b&gt;" style="ellipse;html=1;fillColor=#16202A;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="65" y="536" width="30" height="30" as="geometry"/></mxCell>
<mxCell id="p1008" value="&lt;b&gt;WHAT THE MODEL SEES&lt;/b&gt;" style="text;html=1;horizontal=0;align=center;fontSize=11;fontColor=#65717B;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="22" y="517" width="40" height="131" as="geometry"/></mxCell>
<mxCell id="p1009" value="" style="rounded=1;arcSize=6;html=1;fillColor=#F5F7F8;strokeColor=#E3E8EB;container=0;" vertex="1" parent="1"><mxGeometry x="126" y="682" width="1300" height="311" as="geometry"/></mxCell>
<mxCell id="p1010" value="&lt;b&gt;3&lt;/b&gt;" style="ellipse;html=1;fillColor=#16202A;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="65" y="701" width="30" height="30" as="geometry"/></mxCell>
<mxCell id="p1011" value="&lt;b&gt;HOW WELL IT WORKS&lt;/b&gt;" style="text;html=1;horizontal=0;align=center;fontSize=11;fontColor=#65717B;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="22" y="682" width="40" height="311" as="geometry"/></mxCell>
<mxCell id="p1012" value="" style="rounded=1;arcSize=6;html=1;fillColor=#F5F7F8;strokeColor=#E3E8EB;container=0;" vertex="1" parent="1"><mxGeometry x="126" y="1027" width="1300" height="243" as="geometry"/></mxCell>
<mxCell id="p1013" value="&lt;b&gt;4&lt;/b&gt;" style="ellipse;html=1;fillColor=#16202A;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="65" y="1046" width="30" height="30" as="geometry"/></mxCell>
<mxCell id="p1014" value="&lt;b&gt;BEFORE IT IS ALLOWED OUT&lt;/b&gt;" style="text;html=1;horizontal=0;align=center;fontSize=11;fontColor=#65717B;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="22" y="1027" width="40" height="243" as="geometry"/></mxCell>
<mxCell id="p1015" value="" style="rounded=1;arcSize=6;html=1;fillColor=#F5F7F8;strokeColor=#E3E8EB;container=0;" vertex="1" parent="1"><mxGeometry x="126" y="1304" width="1300" height="131" as="geometry"/></mxCell>
<mxCell id="p1016" value="&lt;b&gt;5&lt;/b&gt;" style="ellipse;html=1;fillColor=#16202A;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="65" y="1323" width="30" height="30" as="geometry"/></mxCell>
<mxCell id="p1017" value="&lt;b&gt;THE MODEL THAT SHIPS&lt;/b&gt;" style="text;html=1;horizontal=0;align=center;fontSize=11;fontColor=#65717B;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="22" y="1304" width="40" height="131" as="geometry"/></mxCell>
<mxCell id="p1018" value="" style="rounded=1;arcSize=6;html=1;fillColor=#F5F7F8;strokeColor=#E3E8EB;container=0;" vertex="1" parent="1"><mxGeometry x="126" y="1468" width="1300" height="251" as="geometry"/></mxCell>
<mxCell id="p1019" value="&lt;b&gt;6&lt;/b&gt;" style="ellipse;html=1;fillColor=#16202A;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="65" y="1487" width="30" height="30" as="geometry"/></mxCell>
<mxCell id="p1020" value="&lt;b&gt;AT THE BEDSIDE&lt;/b&gt;" style="text;html=1;horizontal=0;align=center;fontSize=11;fontColor=#65717B;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="22" y="1468" width="40" height="251" as="geometry"/></mxCell>
<mxCell id="start" value="&lt;b&gt;A RECORDING SESSION&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#3B4750;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="160" y="155" width="268" height="44" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S1&lt;/font&gt;&lt;br&gt;&lt;b&gt;Record Known Behaviour&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;the patch is worn while nine known things happen to it, from lying still to a full pull; 81 recordings in all&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#54707F;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#16202A;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="450" y="132" width="460" height="91" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S2&lt;/font&gt;&lt;br&gt;&lt;b&gt;Sort into Four Levels&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;normal, someone touching it, the dressing peeling, the tube being pulled&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#54707F;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#16202A;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="932" y="139" width="460" height="77" as="geometry"/></mxCell>
<mxCell id="stop1" value="&lt;b&gt;STOP - set the recording aside&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#9C3B2E;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="400" y="277" width="400" height="42" as="geometry"/></mxCell>
<mxCell id="d1" value="is the recording usable ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9C3B2E;strokeWidth=1.6;fontSize=12;fontColor=#9C3B2E;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="822" y="253" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="s0" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S0&lt;/font&gt;&lt;br&gt;&lt;b&gt;Check a New Recording&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;does the patch lift as far as the design says it should, before this recording is allowed to teach anything&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9C3B2E;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#9C3B2E;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="305" y="373" width="460" height="91" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S3&lt;/font&gt;&lt;br&gt;&lt;b&gt;Remember Which Data This Came From&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;so the system can tell later whether the model still matches the data behind it&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#54707F;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#16202A;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="787" y="373" width="460" height="91" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S4&lt;/font&gt;&lt;br&gt;&lt;b&gt;Cancel the Slow Drift&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;sweat and body heat move the reading over hours; only a sudden change means something is happening&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#54707F;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#16202A;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="295" y="537" width="470" height="91" as="geometry"/></mxCell>
<mxCell id="s5" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S5&lt;/font&gt;&lt;br&gt;&lt;b&gt;Describe Each Moment&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;how far each of the 25 pads moved, how many moved together, and how deep&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#54707F;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#16202A;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="787" y="544" width="470" height="77" as="geometry"/></mxCell>
<mxCell id="hA" value="&lt;b&gt;PER RECORDING&lt;/b&gt;" style="rounded=1;arcSize=18;html=1;fillColor=#17323E;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="154" y="702" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="hB" value="&lt;b&gt;PER REAL EVENT&lt;/b&gt;" style="rounded=1;arcSize=18;html=1;fillColor=#2F5B6D;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="576" y="702" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="hC" value="&lt;b&gt;ALARM BURDEN&lt;/b&gt;" style="rounded=1;arcSize=18;html=1;fillColor=#4C8299;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="998" y="702" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="a1" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S6&lt;/font&gt;&lt;br&gt;&lt;b&gt;Test on a Recording It Never Saw&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;learn from the other 80, then judge the one held back, and repeat for all 81&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17323E;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#17323E;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="154" y="762" width="400" height="91" as="geometry"/></mxCell>
<mxCell id="b1" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S8&lt;/font&gt;&lt;br&gt;&lt;b&gt;Judge Every Moment Blind&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;each moment is scored by a model that never learned from its own recording&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5B6D;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#2F5B6D;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="576" y="762" width="400" height="91" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S10&lt;/font&gt;&lt;br&gt;&lt;b&gt;Try Every Alarm Setting&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;how many agreeing moments before it sounds, and how long it keeps sounding&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C8299;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#3F6F84;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="998" y="762" width="400" height="91" as="geometry"/></mxCell>
<mxCell id="a2" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S7&lt;/font&gt;&lt;br&gt;&lt;b&gt;How Often the Clip Is Called Right&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;79 of 81, and the honest range around that is 91 to 99 per cent&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17323E;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#17323E;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="154" y="889" width="400" height="77" as="geometry"/></mxCell>
<mxCell id="b2" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S9&lt;/font&gt;&lt;br&gt;&lt;b&gt;How Many Real Events Are Caught&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;every one of them, and the warning comes about six seconds in&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5B6D;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#2F5B6D;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="576" y="889" width="400" height="77" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S11&lt;/font&gt;&lt;br&gt;&lt;b&gt;Choose What a Ward Can Live With&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;catches every event, at the cost of roughly eight false alarms an hour&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C8299;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#3F6F84;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="998" y="882" width="400" height="91" as="geometry"/></mxCell>
<mxCell id="s12" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S12&lt;/font&gt;&lt;br&gt;&lt;b&gt;Write the Measured Numbers Down&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;one report, and it is the only place any figure may be quoted from&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#54707F;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#16202A;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="446" y="1047" width="660" height="77" as="geometry"/></mxCell>
<mxCell id="stop2" value="&lt;b&gt;STOP - then the work is wrong, not the report&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#9C3B2E;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="340" y="1181" width="470" height="42" as="geometry"/></mxCell>
<mxCell id="d2" value="same numbers, everything still passes ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9C3B2E;strokeWidth=1.6;fontSize=12;fontColor=#9C3B2E;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="832" y="1154" width="380" height="96" as="geometry"/></mxCell>
<mxCell id="s13" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S13&lt;/font&gt;&lt;br&gt;&lt;b&gt;Train the Model That Will Be Used&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;a gradient-boosted decision-tree model, learning from every recording at once&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#54707F;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#16202A;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="295" y="1331" width="470" height="77" as="geometry"/></mxCell>
<mxCell id="s14" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S14&lt;/font&gt;&lt;br&gt;&lt;b&gt;Seal It&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;stored with a fingerprint, so a swapped or damaged model is refused rather than quietly used&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9C3B2E;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#9C3B2E;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="787" y="1324" width="470" height="91" as="geometry"/></mxCell>
<mxCell id="r1" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S15&lt;/font&gt;&lt;br&gt;&lt;b&gt;A Reading Arrives&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;all 25 pads, about twice a second&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#54707F;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#16202A;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="154" y="1495" width="400" height="77" as="geometry"/></mxCell>
<mxCell id="r2" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S16&lt;/font&gt;&lt;br&gt;&lt;b&gt;Distrust a Broken Reading&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;if the sensor drops out, hold the last level rather than report that all is well&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#54707F;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#16202A;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="576" y="1488" width="400" height="91" as="geometry"/></mxCell>
<mxCell id="r3" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S17&lt;/font&gt;&lt;br&gt;&lt;b&gt;Cancel the Drift&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;exactly as it was done while learning&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#54707F;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#16202A;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="998" y="1495" width="400" height="77" as="geometry"/></mxCell>
<mxCell id="r4" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S18&lt;/font&gt;&lt;br&gt;&lt;b&gt;Describe the Moment&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;exactly the same description as while learning&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#54707F;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#16202A;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="154" y="1616" width="400" height="77" as="geometry"/></mxCell>
<mxCell id="r5" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S19&lt;/font&gt;&lt;br&gt;&lt;b&gt;Decide What Is Happening&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;too small to matter, a touch, peeling, or a pull, with a risk score alongside&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#54707F;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#16202A;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="576" y="1609" width="400" height="91" as="geometry"/></mxCell>
<mxCell id="r6" value="&lt;font color=&quot;#9BA6AE&quot; style=&quot;font-size:9px&quot;&gt;S20&lt;/font&gt;&lt;br&gt;&lt;b&gt;Wait for Agreement&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#65717B&quot; style=&quot;font-size:10px&quot;&gt;one odd moment is not an alarm; several in a row is&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#54707F;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=13;fontColor=#16202A;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="998" y="1616" width="400" height="77" as="geometry"/></mxCell>
<mxCell id="out" value="&lt;b&gt;OUTPUT     how serious it is,  how risky,  and where the patch is lifting&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#17323E;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Tahoma;" vertex="1" parent="1"><mxGeometry x="266" y="1754" width="1020" height="50" as="geometry"/></mxCell>
